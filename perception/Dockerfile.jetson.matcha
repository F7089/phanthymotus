# Isolated Matcha native baseline for Jetson Orin JP6.1.
# CUDA-enabled sherpa-onnx from source. Does NOT reuse Melo image or
# `pip install sherpa-onnx` (that wheel is CPU-only).
#
#   docker build -f perception/Dockerfile.jetson.matcha --network=host \
#     --build-arg JP_VERSION=61 -t phanthymotus-matcha-native:jp61 .
#
#   ./deploy/matcha_native/run_jetson.sh --bench

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG JP_VERSION=61
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp${JP_VERSION}-torch
ARG PYPI_MIRROR APT_MIRROR

ENV PIP_INDEX_URL=${PYPI_MIRROR} \
    PIP_EXTRA_INDEX_URL= \
    PIP_TRUSTED_HOST="mirrors.tuna.tsinghua.edu.cn pypi.tuna.tsinghua.edu.cn pypi.org files.pythonhosted.org"

RUN if [ -n "${APT_MIRROR}" ]; then \
        sed -i "s/archive.ubuntu.com/${APT_MIRROR}/g; s/ports.ubuntu.com/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi

RUN rm -f /etc/apt/sources.list.d/* && rm -rf /var/cache/apt/archives/* /var/lib/apt/lists/* && \
    apt-get -o Acquire::AllowInsecureRepositories=true update && \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
        git cmake g++ python3-dev wget ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} numpy psutil

# Official Jetson Orin GPU: SHERPA_ONNX_ENABLE_GPU=ON. JP6 CUDA12 → ORT 1.18.1.
# Do not `pip install sherpa-onnx` here.
ARG SHERPA_ONNX_GIT=https://github.com/k2-fsa/sherpa-onnx.git
ARG SHERPA_ONNX_GIT_MIRROR=https://ghfast.top/https://github.com/k2-fsa/sherpa-onnx.git
ARG SHERPA_ONNX_REF=master
ARG SHERPA_ONNX_LINUX_ARM64_GPU_ONNXRUNTIME_VERSION=1.18.1

ENV SHERPA_ONNX_CMAKE_ARGS="-DSHERPA_ONNX_ENABLE_GPU=ON -DSHERPA_ONNX_ENABLE_PYTHON=ON -DSHERPA_ONNX_LINUX_ARM64_GPU_ONNXRUNTIME_VERSION=${SHERPA_ONNX_LINUX_ARM64_GPU_ONNXRUNTIME_VERSION} -DCMAKE_BUILD_TYPE=Release"

RUN set -eux; \
    mkdir -p /tmp/src && cd /tmp/src; \
    if git clone --depth 1 --branch "${SHERPA_ONNX_REF}" "${SHERPA_ONNX_GIT_MIRROR}" sherpa-onnx \
       || git clone --depth 1 --branch "${SHERPA_ONNX_REF}" "${SHERPA_ONNX_GIT}" sherpa-onnx; then \
      echo "cloned ${SHERPA_ONNX_REF}"; \
    else \
      git clone --depth 1 "${SHERPA_ONNX_GIT_MIRROR}" sherpa-onnx \
        || git clone --depth 1 "${SHERPA_ONNX_GIT}" sherpa-onnx; \
    fi; \
    cd sherpa-onnx; \
    python3 setup.py bdist_wheel; \
    pip3 install --no-cache-dir dist/*.whl; \
    python3 - <<'PY'
import sherpa_onnx
print("sherpa-onnx", getattr(sherpa_onnx, "__version__", "?"), sherpa_onnx.__file__)
ver = str(getattr(sherpa_onnx, "__version__", ""))
if "+cuda" not in ver.lower():
    print("WARN: version has no +cuda suffix:", ver)
PY
    rm -rf /tmp/src

WORKDIR /opt/matcha_native
COPY deploy/matcha_native/ /opt/matcha_native/

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    MATCHA_PROVIDER=cuda \
    MATCHA_REQUIRE_CUDA=1 \
    MATCHA_MODEL_DIR=/models/matcha_native \
    MATCHA_WAV_OUT=/wav_out \
    LD_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu/nvidia:/usr/lib/aarch64-linux-gnu:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

LABEL com.nvidia.volumes.needed="nvidia_driver"

ENTRYPOINT ["python3", "/opt/matcha_native/bench_matcha_native.py"]
